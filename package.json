{
  "name": "impfbuch-app",
  "version": "2.1.0",
  "description": "Impfbuch – digitaler Impfpass (Web + Android via Capacitor)",
  "private": true,
  "scripts": {
    "build:www": "node scripts/sync-www.mjs",
    "sync": "node scripts/sync-www.mjs && npx cap sync android",
    "assets": "npx @capacitor/assets generate --android",
    "open:android": "npx cap open android",
    "postinstall": "patch-package"
  },
  "author": "Marc Ewers (MERCwerk)",
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "cordova-plugin-purchase": "^13.18.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
